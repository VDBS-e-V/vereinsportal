APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Zwei-Faktor-Pflicht für Administration, Geschäftsstelle und Vorstand (lokal ohne Authenticator-App abschaltbar)
TWO_FACTOR_REQUIRED=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

VDB_MY_DOMAIN=my.vdb.test

VDB_DEV_ADMIN_EMAIL=admin@vdb.test
VDB_DEV_ADMIN_DEFAULT_PASSWORD="VdbLocalAdmin2026!"
VDB_DEV_ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SUPPORT_ADDRESS="${MAIL_FROM_ADDRESS}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


VDB_REGISTRATION_PRIVACY_NOTICE_VERSION=2026-09-01T21:04:00Z

AUTH_REMEMBER_DURATION=43200
PORTAL_NEXTCLOUD_URL=
PORTAL_MOODLE_URL=

# Mitgliedschaften: Fassungen von Satzung und Datenschutzhinweisen (Einwilligungsnachweis), Hinweis an den Vorstand
PORTAL_STATUTE_VERSION=2026-01
PORTAL_PRIVACY_VERSION=2026-01
MEMBERSHIP_NOTIFY_BOARD=true
# Aufbewahrung in Tagen (leer = nie löschen)
MEMBERSHIP_RETENTION_UNVERIFIED_DAYS=7
MEMBERSHIP_RETENTION_REJECTED_DAYS=180
MEMBERSHIP_RETENTION_ENDED_DAYS=
PORTAL_SURVEY_URL=
