# Vorlage für die .env auf dem Strato-Webhosting. Kopieren, als ".env" speichern, Werte eintragen, per FTP in den Hauptordner des Portals hochladen
# (NICHT in den öffentlichen Ordner public/). Siehe docs/68_WEBHOSTING.md.

APP_NAME="VDBS Vereinsportal"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://portal.IHRE-DOMAIN.de
APP_LOCALE=de
APP_FALLBACK_LOCALE=de
# APP_KEY bleibt zuerst leer: die Einrichtung im Browser erzeugt einen Schlüssel, der hier eingetragen wird.
APP_KEY=

# Einmal-Token für die Einrichtung im Browser (mindestens 16 Zeichen, zufällig). Nach der Einrichtung entfernen.
SETUP_TOKEN=
# Schlüssel für den Cron-Aufruf /cron/<Schlüssel> (mindestens 32 zufällige Zeichen, nur Buchstaben und Ziffern).
CRON_KEY=
PORTAL_TICK_SECONDS=45

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Datenbank (Strato nutzt MariaDB). Werte aus dem Strato-Kundenmenü.
DB_CONNECTION=mariadb
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# E-Mail über den SMTP-Zugang von Strato (Werte aus dem Kundenmenü)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS=portal@IHRE-DOMAIN.de
MAIL_FROM_NAME="VDBS"

# Rundschreiben: an das Mail-Limit des Hosters anpassen (Mails pro Minute, Paketgröße)
MAILINGS_PER_MINUTE=60
MAILINGS_BATCH_SIZE=25

TWO_FACTOR_REQUIRED=true
