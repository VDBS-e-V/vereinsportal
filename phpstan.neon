includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 5
    # Je nach Installation (lokal/CI) melden die Versionen leicht unterschiedliche Altbestände.
    reportUnmatchedIgnoredErrors: false
    parseModelCastsMethod: true
